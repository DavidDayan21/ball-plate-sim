# Virtual environment (recreated with requirements.txt)
.venv/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/

# Error log written by MuJoCo
MUJOCO_LOG.TXT

# Editors
.vscode/
.idea/

# Windows system files
Thumbs.db
desktop.ini

# Exported MuJoCo models (regenerated with python -m simulation.mujoco_physics)
results/*.xml

# Sandbox attempt data (specific to each session)
results/attempts/

# Regression check reference (specific to each machine, regenerated with regression_check.py)
results/reference/
